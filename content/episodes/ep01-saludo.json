  "localization": {
    "es-BO": {
      "EP01_TITLE": "Saludo que puedo elegir",
      "NAME_CAPI": "Capi",
      "NAME_TOMI": "Tomi",
      "NAME_LUNA": "Luna",
      "NAME_CLARA": "Profe Clara",
      "NAME_BETO": "Don Beto",
      "NAME_ALL": "Todos",
      "UI_PAUSE_PROMPT": "Podemos parar cuando quieras.",
      "UI_PAUSE_RESUME": "Seguir",
      "UI_PAUSE_MAP": "Volver al mapa",
      "UI_PAUSE_QUIT": "Terminar por hoy",
      "UI_STOP": "¡Para!",
      "UI_COMPASS_CALM": "Todo tranquilo",
      "UI_COMPASS_UNSURE": "Hmm, no sé",
      "UI_COMPASS_UHOH": "¡Uh-oh!",
      "GREET_WAVE": "Con la mano",
      "GREET_HIGH_FIVE": "Choca cinco",
      "GREET_FIST_BUMP": "Choque de puños",
      "GREET_HUG": "Abrazo",
      "GREET_DISTANCE": "De lejos, con una sonrisa",
      "GREET_NOT_TODAY": "Hoy no, gracias",
      "GREET_NO_THANKS": "No, gracias",
      "EP01_S01_L001": "¡Hola! Te doy la bienvenida a la Isla de los Acuerdos.",
      "EP01_S01_L002": "Yo soy Capi. Soy la guía de esta isla.",
      "EP01_S01_L003": "Anoche sopló un viento travieso. ¡Desordenó caminos y puentes!",
      "EP01_S01_L004": "Aquí arreglamos la isla con acuerdos.",
      "EP01_S01_L005": "Un acuerdo es algo que decidimos para cuidarnos.",
      "EP01_S01_L006": "¿Me ayudas a arreglar el primer puente?",
      "EP01_S01_O001": "¡Sí, vamos!",
      "EP01_S01_O002": "Primero quiero mirar",
      "EP01_S01_L007": "¡Genial! Vamos juntos.",
      "EP01_S01_L008": "Claro. Mira todo lo que quieras. Toca la estrella cuando quieras seguir.",
      "EP01_S02_L001": "Te regalo algo de mi mochila: una brújula del cuerpo.",
      "EP01_S02_L002": "No marca el norte. Marca cómo se siente tu cuerpo.",
      "EP01_S02_L003": "Sol: todo tranquilo.",
      "EP01_S02_L004": "Nube: hmm, no estoy seguro.",
      "EP01_S02_L005": "Uh-oh: algo no se siente bien.",
      "EP01_S02_L006": "Uh-oh puede sentirse como cosquillas raras en la panza, calor en la cara o ganas de alejarte.",
      "EP01_S02_L007": "¡Probemos! ¿Qué marca tu brújula?",
      "EP01_S02_T001": "Comer tu fruta favorita.",
      "EP01_S02_T002": "Un ruido fuerte de repente.",
      "EP01_S02_T003": "Cruzar un puente que se mueve.",
      "EP01_S02_F001": "Tu cuerpo te avisa. Aquí no hay respuestas malas.",
      "EP01_S02_F002": "A veces dos personas sienten distinto. Las dos brújulas valen.",
      "EP01_S02_L008": "Tu brújula es tuya. Escucharla te ayuda a elegir.",
      "EP01_S03_L001": "En esta isla, cada quien elige cómo saludar.",
      "EP01_S03_L002": "¿Cómo quieres saludarme?",
      "EP01_S03_R001": "¡Hola, hola!",
      "EP01_S03_R002": "¡Choca esos cinco!",
      "EP01_S03_R003": "¡Pum! Choque de puños.",
      "EP01_S03_R004": "¡Un abrazo! Gracias.",
      "EP01_S03_R005": "¡Hola desde aquí!",
      "EP01_S03_R006": "Está bien. Hoy no saludamos. Igual somos amigos.",
      "EP01_S03_L003": "Cualquier saludo vale si tú lo eliges.",
      "EP01_S03_L004": "Y puedes cambiar de idea. Hasta ahora mismo. ¿Quieres cambiar tu saludo?",
      "EP01_S03_O001": "Sí, quiero cambiar",
      "EP01_S03_O002": "Así está bien",
      "EP01_S04_L001": "¡Hola! Soy Tomi. ¡Estoy explorando la isla!",
      "EP01_S04_L002": "¡Yo abrazo a todos! ¡Ahí voy!",
      "EP01_S04_L003": "¡Espera, Tomi! ¿Qué se hace antes de saludar?",
      "EP01_S04_O001": "Preguntar primero",
      "EP01_S04_O002": "Abrazar rápido",
      "EP01_S04_O003": "No sé",
      "EP01_S04_F001": "¡Eso! Preguntar es una forma de cuidar.",
      "EP01_S04_F002": "A muchos les gustan los abrazos. A otros no. Por eso preguntamos primero.",
      "EP01_S04_F003": "Te ayudo: primero se pregunta. Así el otro puede elegir.",
      "EP01_S04_L004": "¡Ah, verdad! ¿Cómo quieres que te salude?",
      "EP01_S04_R001": "¡Listo!",
      "EP01_S04_R002": "¡Está bien! Te saludo de lejos.",
      "EP01_S04_L005": "¿Jugamos a chocar las manos súper rápido?",
      "EP01_S04_O004": "¡Sí!",
      "EP01_S04_L006": "¿Sigues queriendo jugar?",
      "EP01_S04_O005": "Un poco más",
      "EP01_S04_O006": "¡Para, ya no quiero!",
      "EP01_S04_R003": "¡Ok, paro! Gracias por avisarme.",
      "EP01_S04_F004": "Dijiste que sí y después cambiaste de idea. Eso también se vale.",
      "EP01_S04_F005": "Muy bien. Si en algún momento ya no quieres, puedes decir «para».",
      "EP01_S04_R004": "¡Bueno, otro día!",
      "EP01_S04_F006": "Dijiste que no y Tomi te escuchó. Así se juega.",
      "EP01_S05_L001": "¡Hola! Soy Luna. Estoy mirando este puente roto.",
      "EP01_S05_L002": "Ahora te toca a ti. ¿Cómo saludas a Luna?",
      "EP01_S05_O001": "¿Cómo te gustaría saludar?",
      "EP01_S05_O002": "¿Chocamos puños?",
      "EP01_S05_O003": "¡Te doy un abrazo!",
      "EP01_S05_R001": "¡Gracias por preguntar! Hoy prefiero chocar puños. ¡Pum!",
      "EP01_S05_R002": "¡Sí! ¡Pum!",
      "EP01_S05_F001": "Ofrecer un saludo y dejar que elija también es preguntar.",
      "EP01_S05_R003": "Mmm, hoy no quiero abrazos. Gracias.",
      "EP01_S05_O004": "Está bien. ¿Qué saludo prefieres?",
      "EP01_S05_O005": "¡Pero un abrazo es más bonito!",
      "EP01_S05_R004": "Chocar puños. ¡Pum! Gracias por entender.",
      "EP01_S05_R005": "Te dije que no, gracias.",
      "EP01_S05_F002": "Cuando alguien dice no, paramos. Así también cuidarán tu no. ¿Probamos otra vez?",
      "EP01_S05_L003": "Una cosa más: mi silla es parte de mi espacio. Pregúntame antes de empujarla.",
      "EP01_S05_O006": "¡Entendido!",
      "EP01_S05_O007": "¿Te ayudo a cruzar?",
      "EP01_S05_R006": "¡Genial!",
      "EP01_S05_R007": "Gracias por preguntar. Hoy puedo sola. Si necesito, te aviso.",
      "EP01_S05_L004": "Pedir permiso y respetar la respuesta. ¡Eso es un acuerdo!",
      "EP01_S06_L001": "¡Buenas, buenas! Soy Don Beto. Cuido los caminos de la isla.",
      "EP01_S06_L002": "¡Qué alegría verte! ¿Me das un abrazo de bienvenida?",
      "EP01_S06_R001": "¡Gracias! Bienvenida y bienvenido a todos.",
      "EP01_S06_R002": "¡Claro! Así entonces.",
      "EP01_S06_R003": "Está bien. ¡Igual me alegra verte!",
      "EP01_S06_L003": "¡Ándale, un abracito nomás!",
      "EP01_S06_O001": "Dije que no, gracias.",
      "EP01_S06_O002": "Me voy con Capi.",
      "EP01_S06_O003": "Voy a llamar a la profe.",
      "EP01_S06_O004": "Bueno…",
      "EP01_S06_R004": "Tienes razón. Perdón por insistir.",
      "EP01_S06_F001": "Alejarte también es una forma de cuidarte.",
      "EP01_S06_R005": "¡Tienes razón! Perdón.",
      "EP01_S06_R006": "Beto, eligió no abrazar. Respetemos eso.",
      "EP01_S06_R007": "Tienes razón, profe. Perdón.",
      "EP01_S06_R008": "Espera… te veo dudando. Mejor un saludo con la mano.",
      "EP01_S06_F002": "A veces cuesta decir no. Si no puedes, no es tu culpa. Y siempre lo puedes contar.",
      "EP01_S06_F003": "Fuera de la isla, se lo puedes contar a una persona grande de confianza de tu familia o tu escuela.",
      "EP01_S06_L004": "Hola, soy la profe Clara. Vine a ver el puente.",
      "EP01_S06_L005": "Puedes ser amable y elegir tu saludo.",
      "EP01_S06_L006": "Las personas grandes también respetamos tu elección.",
      "EP01_S07_L001": "¡Mira! Con lo que practicaste, podemos arreglar el puente.",
      "EP01_S07_T001": "Yo elijo mi saludo.",
      "EP01_S07_T002": "Puedo cambiar de idea.",
      "EP01_S07_T003": "Respeto el no de los demás.",
      "EP01_S07_L002": "Acuerdo de hoy: mi cuerpo es mío. Yo elijo mi saludo y respeto el de los demás.",
      "EP01_S07_L003": "Y si tu brújula marca uh-oh, lo puedes contar a una persona grande de confianza.",
      "EP01_S07_L004": "¡Pronto vamos a buscar a esas personas!",
      "EP01_S07_L005": "Gracias por ayudarme. Ahora conversemos con tu profe o tu familia.",
      "DEBRIEF_TITLE": "¡A conversar!",
      "DEBRIEF_CHILD": "¡Arreglaste el puente! Ahora conversa con tu profe o tu familia.",
      "EP01_DB_Q001": "¿Qué formas de saludar vimos en la isla? ¿Cuál más se les ocurre?",
      "EP01_DB_Q002": "¿Qué hizo Tomi antes de saludar, después de que Capi lo detuvo? ¿Por qué sirve preguntar?",
      "EP01_DB_Q003": "Luna dijo «hoy no quiero abrazos». ¿Qué se hace cuando alguien dice no?",
      "EP01_DB_Q004": "¿Una niña o un niño puede decirle «no, gracias» a un abrazo de una persona grande? ¿Cómo lo puede decir con amabilidad?",
      "EP01_DB_Q005": "Si alguien insiste aunque dijiste no, ¿qué más puedes hacer?",
      "EP01_DB_ACT001": "Mi cartel de saludos: dibuja tres saludos que te gustan, sin nombres ni fotos. En parejas, pregunten: «¿Cómo te gustaría que te salude?» y respeten la respuesta.",
      "EP01_DB_FAM001": "¿Cómo te gusta saludar a la familia cuando llegan visitas?",
      "EP01_DB_FAM002": "Si no tienes ganas de dar un beso o un abrazo, ¿qué otro saludo podrías hacer?"
    }
  }
}
